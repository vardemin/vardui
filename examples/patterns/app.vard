// Patterns from knowledge/skills/vard-app/SKILL.md, kept compiling and tested here.
struct Item { id: Int, name: String, done: Bool = false }
extern fn share(text: String) -> Bool

view ItemRow(bind item: Item, onDelete: fn() = {}) {
  Row(gap: 12, align: .center) {
    Checkbox(value: item.done, label: item.name, grow: 1)
    Button("Delete", kind: .text, onTap: onDelete)
  }
}

view App {
  state items: [Item] = []
  state email = ""
  state password = ""
  state shared = false
  let valid = email.contains("@") && password.count >= 8
  fn signIn() { shared = share("hi {email}") }
  Column(grow: 1) {
    Text("Title", style: .title, padding: 16)
    Input(value: email, placeholder: "Email", id: "email")
    Input(value: password, placeholder: "Password", secure: true, id: "password")
    Button("Sign in", enabled: valid, onTap: signIn)
    Scroll(grow: 1, paddingX: 16, gap: 8) {
      for it in items by it.id { ItemRow(item: it, onDelete: { items.removeWhere(x => x.id == it.id) }) }
      if items.isEmpty { Text("Nothing yet", color: .muted, textAlign: .center, paddingY: 32) }
    }
    Button("Add", onTap: { items.append(Item(id: items.count + 1, name: "New {items.count + 1}")) }, alignSelf: .stretch)
  }
}

// Navigation stack with predictive back (skill vard-app)
enum Screen { list, detail }
view Nav {
  state stack: [Screen] = [.list]
  on back if stack.count > 1 { stack.removeAt(stack.count - 1) }
  Column(grow: 1, offsetX: backProgress * 64) {
    if (stack.last ?? .list) == .list {
      Button("Open detail", onTap: { stack.append(.detail) })
    } else {
      Text("Detail screen")
    }
  }
}

// Animations (skill vard-app): `animate:` interpolates prop changes, `enter:` plays on appear
view Animated {
  state open = false
  Column(grow: 1, gap: 12, padding: 16) {
    Button(open ? "Hide" : "Show", onTap: { open = !open })
    Column(id: "panel", height: open ? 120 : 48, background: open ? .primary : .surface, radius: 12,
           opacity: open ? 1 : 0.6, animate: .spring) {
      Text("Panel", padding: 12)
    }
    if open { Text("Details", id: "details", enter: .slideUp, duration: 200) }
  }
}
