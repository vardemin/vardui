// Tailwind CSS for Vard — package `tailwind` (`vard add tailwind`).
//
// 1. The full Tailwind palette as color tokens: `.slate50` ... `.rose950` (light = dark).
// 2. Vard's semantic tokens mapped to a Tailwind look (slate neutrals, indigo accent), with
//    dark values — use these in views so dark mode works; reach for palette tokens for accents.
// 3. Components with Tailwind defaults (rounded-lg, shadow-sm, ring-1, px-4 py-2 ...):
//    TwButton TwCard Badge Avatar Field TextArea Segmented Chip Progress IconButton.
// Class -> prop mapping: `vard doc design` (p-4 = padding: 16, rounded-xl = radius: 12, ...).

theme {
  slate50: #F8FAFC, slate100: #F1F5F9, slate200: #E2E8F0, slate300: #CBD5E1, slate400: #94A3B8, slate500: #64748B, slate600: #475569, slate700: #334155, slate800: #1E293B, slate900: #0F172A, slate950: #020617,
  gray50: #F9FAFB, gray100: #F3F4F6, gray200: #E5E7EB, gray300: #D1D5DB, gray400: #9CA3AF, gray500: #6B7280, gray600: #4B5563, gray700: #374151, gray800: #1F2937, gray900: #111827, gray950: #030712,
  zinc50: #FAFAFA, zinc100: #F4F4F5, zinc200: #E4E4E7, zinc300: #D4D4D8, zinc400: #A1A1AA, zinc500: #71717A, zinc600: #52525B, zinc700: #3F3F46, zinc800: #27272A, zinc900: #18181B, zinc950: #09090B,
  neutral50: #FAFAFA, neutral100: #F5F5F5, neutral200: #E5E5E5, neutral300: #D4D4D4, neutral400: #A3A3A3, neutral500: #737373, neutral600: #525252, neutral700: #404040, neutral800: #262626, neutral900: #171717, neutral950: #0A0A0A,
  stone50: #FAFAF9, stone100: #F5F5F4, stone200: #E7E5E4, stone300: #D6D3D1, stone400: #A8A29E, stone500: #78716C, stone600: #57534E, stone700: #44403C, stone800: #292524, stone900: #1C1917, stone950: #0C0A09,
  red50: #FEF2F2, red100: #FEE2E2, red200: #FECACA, red300: #FCA5A5, red400: #F87171, red500: #EF4444, red600: #DC2626, red700: #B91C1C, red800: #991B1B, red900: #7F1D1D, red950: #450A0A,
  orange50: #FFF7ED, orange100: #FFEDD5, orange200: #FED7AA, orange300: #FDBA74, orange400: #FB923C, orange500: #F97316, orange600: #EA580C, orange700: #C2410C, orange800: #9A3412, orange900: #7C2D12, orange950: #431407,
  amber50: #FFFBEB, amber100: #FEF3C7, amber200: #FDE68A, amber300: #FCD34D, amber400: #FBBF24, amber500: #F59E0B, amber600: #D97706, amber700: #B45309, amber800: #92400E, amber900: #78350F, amber950: #451A03,
  yellow50: #FEFCE8, yellow100: #FEF9C3, yellow200: #FEF08A, yellow300: #FDE047, yellow400: #FACC15, yellow500: #EAB308, yellow600: #CA8A04, yellow700: #A16207, yellow800: #854D0E, yellow900: #713F12, yellow950: #422006,
  lime50: #F7FEE7, lime100: #ECFCCB, lime200: #D9F99D, lime300: #BEF264, lime400: #A3E635, lime500: #84CC16, lime600: #65A30D, lime700: #4D7C0F, lime800: #3F6212, lime900: #365314, lime950: #1A2E05,
  green50: #F0FDF4, green100: #DCFCE7, green200: #BBF7D0, green300: #86EFAC, green400: #4ADE80, green500: #22C55E, green600: #16A34A, green700: #15803D, green800: #166534, green900: #14532D, green950: #052E16,
  emerald50: #ECFDF5, emerald100: #D1FAE5, emerald200: #A7F3D0, emerald300: #6EE7B7, emerald400: #34D399, emerald500: #10B981, emerald600: #059669, emerald700: #047857, emerald800: #065F46, emerald900: #064E3B, emerald950: #022C22,
  teal50: #F0FDFA, teal100: #CCFBF1, teal200: #99F6E4, teal300: #5EEAD4, teal400: #2DD4BF, teal500: #14B8A6, teal600: #0D9488, teal700: #0F766E, teal800: #115E59, teal900: #134E4A, teal950: #042F2E,
  cyan50: #ECFEFF, cyan100: #CFFAFE, cyan200: #A5F3FC, cyan300: #67E8F9, cyan400: #22D3EE, cyan500: #06B6D4, cyan600: #0891B2, cyan700: #0E7490, cyan800: #155E75, cyan900: #164E63, cyan950: #083344,
  sky50: #F0F9FF, sky100: #E0F2FE, sky200: #BAE6FD, sky300: #7DD3FC, sky400: #38BDF8, sky500: #0EA5E9, sky600: #0284C7, sky700: #0369A1, sky800: #075985, sky900: #0C4A6E, sky950: #082F49,
  blue50: #EFF6FF, blue100: #DBEAFE, blue200: #BFDBFE, blue300: #93C5FD, blue400: #60A5FA, blue500: #3B82F6, blue600: #2563EB, blue700: #1D4ED8, blue800: #1E40AF, blue900: #1E3A8A, blue950: #172554,
  indigo50: #EEF2FF, indigo100: #E0E7FF, indigo200: #C7D2FE, indigo300: #A5B4FC, indigo400: #818CF8, indigo500: #6366F1, indigo600: #4F46E5, indigo700: #4338CA, indigo800: #3730A3, indigo900: #312E81, indigo950: #1E1B4B,
  violet50: #F5F3FF, violet100: #EDE9FE, violet200: #DDD6FE, violet300: #C4B5FD, violet400: #A78BFA, violet500: #8B5CF6, violet600: #7C3AED, violet700: #6D28D9, violet800: #5B21B6, violet900: #4C1D95, violet950: #2E1065,
  purple50: #FAF5FF, purple100: #F3E8FF, purple200: #E9D5FF, purple300: #D8B4FE, purple400: #C084FC, purple500: #A855F7, purple600: #9333EA, purple700: #7E22CE, purple800: #6B21A8, purple900: #581C87, purple950: #3B0764,
  fuchsia50: #FDF4FF, fuchsia100: #FAE8FF, fuchsia200: #F5D0FE, fuchsia300: #F0ABFC, fuchsia400: #E879F9, fuchsia500: #D946EF, fuchsia600: #C026D3, fuchsia700: #A21CAF, fuchsia800: #86198F, fuchsia900: #701A75, fuchsia950: #4A044E,
  pink50: #FDF2F8, pink100: #FCE7F3, pink200: #FBCFE8, pink300: #F9A8D4, pink400: #F472B6, pink500: #EC4899, pink600: #DB2777, pink700: #BE185D, pink800: #9D174D, pink900: #831843, pink950: #500724,
  rose50: #FFF1F2, rose100: #FFE4E6, rose200: #FECDD3, rose300: #FDA4AF, rose400: #FB7185, rose500: #F43F5E, rose600: #E11D48, rose700: #BE123C, rose800: #9F1239, rose900: #881337, rose950: #4C0519,
  white: #FFFFFF, black: #000000,
  background: #FFFFFF, surface: #F8FAFC, text: #0F172A, muted: #64748B,
  primary: #4F46E5, onPrimary: #FFFFFF, border: #E2E8F0,
  danger: #DC2626, success: #16A34A, warning: #D97706,
  card: #FFFFFF, ring: #E2E8F0, accent: #EEF2FF, onAccent: #4338CA
}

theme dark {
  background: #020617, surface: #0F172A, text: #F8FAFC, muted: #94A3B8,
  primary: #818CF8, onPrimary: #1E1B4B, border: #1E293B,
  danger: #F87171, success: #4ADE80, warning: #FBBF24,
  card: #0F172A, ring: #1E293B, accent: #1E1B4B, onAccent: #C7D2FE
}

enum TwVariant { primary, secondary, soft, outline, ghost, danger }
enum TwSize { sm, md, lg }
enum TwTone { gray, indigo, green, amber, red }

// <button class="rounded-md bg-indigo-600 px-3.5 py-2.5 text-sm font-semibold text-white shadow-sm">
// The outer Row is the 44dp touch target; the inner Row is what you see (sm = 32, md = 40, lg = 48).
view TwButton(label: String, onTap: fn() = {}, variant: TwVariant = .primary, size: TwSize = .md, enabled: Bool = true) {
  Row(minHeight: 44, minWidth: 44, align: .center, role: .button, label: label, enabled: enabled, onTap: onTap) {
    Row(
      height: size == .sm ? 32 : size == .lg ? 48 : 40, grow: 1,
      paddingX: size == .sm ? 12 : size == .lg ? 20 : 16,
      radius: 8, align: .center, justify: .center,
      background: variant == .primary ? .primary : variant == .secondary ? .card : variant == .soft ? .accent : variant == .danger ? .danger : .clear,
      border: variant == .secondary || variant == .outline ? 1 : 0, borderColor: .ring,
      shadow: variant == .primary || variant == .secondary || variant == .danger ? .sm : .none,
      opacity: enabled ? 1 : 0.5
    ) {
      Text(label, size: size == .lg ? 16 : 14, weight: .semibold,
           color: variant == .primary ? .onPrimary : variant == .danger ? .onPrimary : variant == .soft ? .onAccent : variant == .ghost ? .primary : .text)
    }
  }
}

// <div class="rounded-xl bg-white p-6 shadow-sm ring-1 ring-slate-200">
view TwCard(content: slot) {
  Column(padding: 24, gap: 12, radius: 12, background: .card, border: 1, borderColor: .ring, shadow: .sm) {
    content
  }
}

// <span class="rounded-full bg-indigo-50 px-2 py-1 text-xs font-medium text-indigo-700 ring-1 ring-indigo-700/10">
view Badge(label: String, tone: TwTone = .gray) {
  Row(paddingX: 8, paddingY: 2, radius: 999, align: .center,
      background: isDark
        ? (tone == .indigo ? .indigo950 : tone == .green ? .green950 : tone == .amber ? .amber950 : tone == .red ? .red950 : .slate800)
        : (tone == .indigo ? .indigo50 : tone == .green ? .green50 : tone == .amber ? .amber50 : tone == .red ? .red50 : .slate100)) {
    // dark: bg-indigo-950 text-indigo-300
    Text(label, size: 12, lineHeight: 16, weight: .medium,
         color: isDark
           ? (tone == .indigo ? .indigo300 : tone == .green ? .green300 : tone == .amber ? .amber300 : tone == .red ? .red300 : .slate300)
           : (tone == .indigo ? .indigo700 : tone == .green ? .green700 : tone == .amber ? .amber800 : tone == .red ? .red700 : .slate600))
  }
}

// <span class="inline-flex size-10 items-center justify-center rounded-full bg-slate-500">
view Avatar(initials: String, size: Float = 40, color: Color = #6366F1) {
  Row(width: size, height: size, radius: size / 2, align: .center, justify: .center, background: color) {
    Text(initials, size: size * 0.4, weight: .semibold, color: #FFFFFF)
  }
}

// <label class="text-sm font-medium"> + <input class="rounded-md ring-1 ring-slate-300 px-3 py-1.5">
view Field(label: String, bind value: String, placeholder: String = "", secure: Bool = false, keyboard: Keyboard = .text) {
  Column(gap: 8) {
    Text(label, size: 14, weight: .medium)
    Input(value: value, placeholder: placeholder, secure: secure, keyboard: keyboard, size: 14, radius: 6, border: 1, borderColor: .ring, background: .card)
  }
}

// <textarea rows="4" class="rounded-md ring-1 ring-slate-300 px-3 py-1.5">: a multi-line Input
view TextArea(label: String, bind value: String, placeholder: String = "", lines: Int = 4) {
  Column(gap: 8) {
    if label != "" { Text(label, size: 14, weight: .medium) }
    Input(value: value, placeholder: placeholder, lines: lines, size: 14, radius: 6, border: 1, borderColor: .ring, background: .card)
  }
}

// <span class="isolate inline-flex rounded-lg bg-slate-200 p-1"><button class="rounded-md bg-white shadow-sm">
// Each segment is a 44dp touch target around a 36dp pill.
view Segmented(options: [String], bind selected: String) {
  Row(radius: 10, background: .ring) {
    for o in options by o {
      Row(grow: 1, height: 44, padding: 4, role: .button, label: o, checked: selected == o, onTap: { selected = o }) {
        Row(grow: 1, radius: 8, align: .center, justify: .center, paddingX: 8,
            background: selected == o ? .card : .clear, shadow: selected == o ? .sm : .none) {
          Text(o, size: 14, weight: selected == o ? .semibold : .medium, maxLines: 1)
        }
      }
    }
  }
}

// <span class="rounded-full px-3 py-1 text-sm ring-1"> as a toggle: a filter pill with a 44dp target
view Chip(label: String, selected: Bool = false, onTap: fn() = {}) {
  Row(height: 44, minWidth: 44, align: .center, justify: .center, role: .button, label: label, checked: selected, onTap: onTap) {
    Row(paddingX: 12, height: 32, radius: 999, align: .center,
        background: selected ? .primary : .card, border: 1, borderColor: selected ? .primary : .ring) {
      Text(label, size: 13, weight: .medium, maxLines: 1, color: selected ? .onPrimary : .text)
    }
  }
}

// <div class="h-2 rounded-full bg-slate-200"><div class="h-2 rounded-full bg-indigo-600" style="width: 62%">
view Progress(value: Float, color: Color = .primary, height: Float = 8) {
  Row(height: height, radius: height / 2, background: .ring, clip: true) {
    Column(grow: clamp(value, 0.0, 1.0), radius: height / 2, background: color)
    Spacer(grow: 1 - clamp(value, 0.0, 1.0))
  }
}

// <button class="rounded-full p-2 hover:bg-slate-100"><svg class="size-5"/></button> with a glyph icon
view IconButton(icon: String, label: String, onTap: fn() = {}, variant: TwVariant = .ghost, size: Float = 40) {
  Row(minWidth: 44, minHeight: 44, align: .center, justify: .center, role: .button, label: label, onTap: onTap) {
    Row(width: size, height: size, radius: size / 2, align: .center, justify: .center,
        background: variant == .primary ? .primary : variant == .soft ? .accent : variant == .danger ? .danger : variant == .secondary ? .card : .clear,
        border: variant == .secondary || variant == .outline ? 1 : 0, borderColor: .ring) {
      Text(icon, size: size * 0.45, weight: .semibold,
           color: variant == .primary || variant == .danger ? .onPrimary : variant == .soft ? .onAccent : variant == .ghost ? .muted : .text)
    }
  }
}
