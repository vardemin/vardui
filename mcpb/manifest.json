{
  "manifest_version": "0.3",
  "name": "vard",
  "display_name": "Vard",
  "version": "0.0.0",
  "description": "AI-first UI framework tools: check Vard apps with machine fixes, run them headless, test, read docs, find and add packages.",
  "author": {
    "name": "vardemin",
    "url": "https://github.com/vardemin"
  },
  "homepage": "https://vardemin.github.io/vardui/",
  "repository": {
    "type": "git",
    "url": "https://github.com/vardemin/vardui"
  },
  "license": "MIT OR Apache-2.0",
  "server": {
    "type": "binary",
    "entry_point": "server/vard",
    "mcp_config": {
      "command": "${__dirname}/server/vard",
      "args": ["mcp"],
      "env": {},
      "platform_overrides": {
        "win32": { "command": "${__dirname}/server/vard.exe" },
        "linux": { "command": "${__dirname}/server/vard-linux" }
      }
    }
  },
  "compatibility": {
    "platforms": ["darwin", "win32", "linux"]
  }
}
